{
  "name": "hero-marketplace-ui",
  "version": "3.2.1",
  "private": true,
  "author": "YinsPeace",
  "description": "HONK Marketplace - A DeFi Kingdoms Hero Trading Platform",
  "homepage": ".",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YinsPeace/HONK-marketplace.git"
  },
  "dependencies": {
    "@apollo/client": "^3.9.9",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@openzeppelin/cli": "^2.8.2",
    "@rainbow-me/rainbowkit": "^2.2.1",
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-virtual": "^3.11.2",
    "@wagmi/core": "^2.15.2",
    "@web3modal/ethereum": "^2.7.1",
    "@web3modal/react": "^2.7.1",
    "ajv": "^6.12.6",
    "ajv-keywords": "^3.5.2",
    "axios": "^1.7.9",
    "big-integer": "^1.6.52",
    "dotenv": "^16.0.3",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "follow-redirects": "^1.15.9",
    "graphql": "^16.8.1",
    "idb": "^8.0.1",
    "lodash": "^4.17.21",
    "luxon": "^3.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.22.3",
    "react-toastify": "^10.0.5",
    "tar": "^7.4.3",
    "tough-cookie": "^5.0.0",
    "viem": "^2.21.55",
    "wagmi": "^2.14.3",
    "web3": "^4.16.0",
    "web3modal": "^1.9.12"
  },
  "scripts": {
    "start": "set DISABLE_ESLINT_PLUGIN=true && set NODE_OPTIONS=--openssl-legacy-provider && react-app-rewired start",
    "build": "set DISABLE_ESLINT_PLUGIN=true && set DISABLE_ESLINT_PLUGIN=true && react-app-rewired build",
    "test": "set DISABLE_ESLINT_PLUGIN=true && react-app-rewired test",
    "package": "set DISABLE_ESLINT_PLUGIN=true && npm run build && pkg . -t node14-win-x64 -o dist/HONK-Marketplace.exe --public --compress GZip",
    "package-debug": "set DISABLE_ESLINT_PLUGIN=true && npm run build && pkg . -t node14-win-x64 -o dist/HONK-Marketplace.exe --public --debug",
    "package-list": "set DISABLE_ESLINT_PLUGIN=true && pkg . -t node14-win-x64 --public --debug > pkg-files.txt",
    "serve": "set DISABLE_ESLINT_PLUGIN=true && node server.js",
    "serve-prod": "set DISABLE_ESLINT_PLUGIN=true && npm run build && node server.js",
    "lint": "set DISABLE_ESLINT_PLUGIN=true && eslint src/**/*.{js,jsx}",
    "lint:fix": "set DISABLE_ESLINT_PLUGIN=true && eslint src/**/*.{js,jsx} --fix",
    "format": "set DISABLE_ESLINT_PLUGIN=true && prettier --write src/**/*.{js,jsx,json,css,scss,md}",
    "check-format": "set DISABLE_ESLINT_PLUGIN=true && prettier --check src/**/*.{js,jsx,json,css,scss,md}",
    "check-all": "set DISABLE_ESLINT_PLUGIN=true && npm run check-format && npm run lint",
    "package-win": "set DISABLE_ESLINT_PLUGIN=true && npm run build && pkg . -t node14-win-x64 -o dist/HONK-Marketplace-win.exe --public --compress GZip",
    "package-mac": "set DISABLE_ESLINT_PLUGIN=true && npm run build && pkg . -t node14-macos-x64 -o dist/HONK-Marketplace-mac --public --compress GZip",
    "package-linux": "set DISABLE_ESLINT_PLUGIN=true && npm run build && pkg . -t node14-linux-x64 -o dist/HONK-Marketplace-linux --public --compress GZip",
    "package-all": "set DISABLE_ESLINT_PLUGIN=true && npm run package-win && npm run package-mac && npm run package-linux"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-syntax-bigint": "^7.8.3",
    "@babel/preset-env": "^7.25.3",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.12",
    "@nomicfoundation/ignition-core": "^0.15.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.1.0",
    "@openzeppelin/truffle-upgrades": "^1.21.0",
    "@truffle/hdwallet-provider": "^1.7.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "autoprefixer": "^10.4.18",
    "chai": "^4.2.0",
    "customize-cra": "^1.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.2",
    "hardhat": "^2.19.5",
    "hardhat-gas-reporter": "^1.0.10",
    "http-proxy-middleware": "^3.0.3",
    "pkg": "^5.8.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "react-app-rewired": "^2.2.1",
    "react-scripts": "5.0.1",
    "solidity-coverage": "^0.8.1",
    "tailwindcss": "^3.4.1",
    "truffle-plugin-verify": "^0.6.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "build/**/*"
    ],
    "targets": [
      "node14-win-x64"
    ],
    "outputPath": "dist"
  }
}
